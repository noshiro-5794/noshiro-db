# Backend origin. Frontend request paths already include /api/v1.
VITE_API_BASE_URL=https://api.noshiro.moe

# Public site origin used for canonical URLs and share metadata.
VITE_SITE_URL=https://app.noshiro.moe

# Public hCaptcha site key only. Keep the hCaptcha secret in backend env.
VITE_HCAPTCHA_SITE_KEY=
