DATABASE_URL=postgresql://noshiro:change-me@127.0.0.1:5432/noshiro_db
CORS_ALLOWED_ORIGINS=http://localhost:5173
CORS_ALLOW_CREDENTIALS=true
ENABLE_API_DOCS=true
AVATAR_MAX_UPLOAD_SIZE=10485760
AVATAR_ALLOWED_CONTENT_TYPES=image/jpeg,image/png,image/webp
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_PUBLIC_URL=
JWT_SECRET=
REFRESH_COOKIE_NAME=noshiro_refresh
REFRESH_COOKIE_PATH=/api/v1/auth/
REFRESH_COOKIE_DOMAIN=
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax
REFRESH_COOKIE_MAX_AGE=2592000
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
REDIS_CACHE_URL=redis://127.0.0.1:6379/1
HCAPTCHA_ENABLED=false
HCAPTCHA_SECRET_KEY=
HCAPTCHA_SITEVERIFY_URL=https://api.hcaptcha.com/siteverify
HCAPTCHA_TIMEOUT=5
TZ=Asia/Shanghai
MCP_HOST=127.0.0.1
MCP_PORT=8011
