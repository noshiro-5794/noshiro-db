# Server-only Vite proxy target for local development. Do not append /api/v1.
API_PROXY_TARGET=https://api.noshiro.moe

# Leave empty to use the same-origin Vite proxy. This also adapts the production
# Secure refresh cookie for Vite's HTTP-only development origin.
VITE_API_BASE_URL=

# Public site origin used for canonical URLs and share metadata.
VITE_SITE_URL=http://localhost:5173

# Public hCaptcha site key only. Keep the hCaptcha secret in backend env.
VITE_HCAPTCHA_SITE_KEY=
